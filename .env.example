# Host user/group IDs.
# These ensure files created inside the container are owned by your host user,
# avoiding workspace permission issues. Get your values with `id -u` and `id -g`.
HOST_UID=1000
HOST_GID=1000

# Workspace directory on your host machine.
#
# Relative paths are resolved from the directory containing compose.yml.
# Absolute paths are also supported.
#
# Examples:
# WORKSPACE_DIR=./workspace
# WORKSPACE_DIR=../my-projects
# WORKSPACE_DIR=/home/alice/projects
# WORKSPACE_DIR=/Users/alice/Developer
#
# Copy this file to .env and customize the values.
WORKSPACE_DIR=./workspace